rule umap_genes_ingested:
    input: umap=DATA_DIR+'/umap_ingested/{sample}_umap_ingested.csv',data='popular_genes_datasets/{sample}_log2cpm.csv'
    output:plot_out='genes_umap_ingested/{sample}_umap_genes.pdf'
